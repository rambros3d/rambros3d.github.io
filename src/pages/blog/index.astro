---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Navbar from '../../components/Navbar.astro';
import { SITE_DESCRIPTION } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<script is:inline src="/theme-init.js"></script>
		<BaseHead title="RamBros Blog" description={SITE_DESCRIPTION} />
	</head>
	<body class="blog-page">
		<Navbar docsLink="/home/" />
		<div class="blog-container">
			<main>
				<p class="blog-about">{SITE_DESCRIPTION}</p>
				<ul class="post-list">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<div class="post-item">
									<p class="title">{post.data.title}</p>
									<div class="dotted-divider"></div>
									<p class="date font-features">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</div>
							</a>
						</li>
					))}
				</ul>
				<div class="placeholder"></div>
			</main>
		</div>
		<Footer />
		<script is:inline src="/theme.js"></script>
	</body>
</html>
